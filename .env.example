# ---- LLM (Claude) ----------------------------------------------------------
# anthropic = production. fake = offline demo provider (no key, no real understanding).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max — start low for chat, raise only if evals improve
AGENT_EFFORT=low
# Server-side refusal fallback; set false on Bedrock / Vertex / Foundry
LLM_REFUSAL_FALLBACKS=true

# ---- Search index -------------------------------------------------------------
# qdrant (default): BM25 sparse + dense vectors in Qdrant, fused server-side.
#   QDRANT_URL empty = embedded in-memory Qdrant (dev only).
# pgvector / memory: in-process BM25 (+ pgvector / in-memory vectors).
VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=toktok_knowledge

# ---- Knowledge modes ------------------------------------------------------------
# auto: whole published knowledge in the cached system prompt while it fits, else RAG.
KNOWLEDGE_MODE=auto
FULL_CONTEXT_MAX_TOKENS=50000
# RAG quality options (cost API calls): Voyage rerank, LLM-written chunk context.
RERANK_PROVIDER=none
VOYAGE_RERANK_MODEL=rerank-2.5
CONTEXTUAL_RETRIEVAL=false
# Authors cannot approve their own knowledge changes (admins can).
CMS_FOUR_EYES=true

# ---- Embeddings (vector leg of hybrid search) ------------------------------
# none = keyword (BM25) only. voyage = Voyage AI multilingual embeddings.
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
EMBEDDING_DIM=1024

# ---- Storage (empty = in-memory, dev only) ---------------------------------
DATABASE_URL=
REDIS_URL=

# ---- Escalation phones shown to users ---------------------------------------
OPERATOR_PHONE_DRIVER=7000-0000
OPERATOR_PHONE_CLIENT=7000-0001
OPERATOR_PHONE_CUSTOMER=7000-0002

# ---- Staff SSO (OpenID Connect) ---------------------------------------------
# Google Workspace : OIDC_ISSUER=https://accounts.google.com
# Microsoft Entra  : OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
OIDC_ALLOWED_DOMAINS=["toktok.mn"]
# First admins (everyone else is added in the admin UI)
STAFF_BOOTSTRAP_ADMINS=[]
# 32+ random characters, e.g. `openssl rand -hex 32`
STAFF_SESSION_SECRET=change-me-session
FRONTEND_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# ---- Human handoff ----------------------------------------------------------
# inchat: operator replies in the same chat (/operator console). phone: ticket + phone only.
HANDOFF_MODE=inchat
# Optional: mirror handoff events to a helpdesk / automation (HMAC-signed JSON POST)
HANDOFF_WEBHOOK_URL=
HANDOFF_WEBHOOK_SECRET=

# ---- Online evaluation ------------------------------------------------------
JUDGE_SAMPLE_RATE=0.1

# ---- Security ----------------------------------------------------------------
# Break-glass / automation key (acts as admin). Staff use SSO.
ADMIN_API_KEY=change-me
USER_REF_SALT=change-me-too
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=20

# ---- Observability (Langfuse Cloud or self-hosted) --------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
